generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// 플랫폼 설정 (미확정 대괄호 값들을 DB에서 관리)
// ─────────────────────────────────────────────────────────

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────
// 테넌트 (학원)
// ─────────────────────────────────────────────────────────

model Tenant {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  slug          String   @unique
  name          String
  theme         Theme    @default(warm)
  accentColor   String?  // 원장이 바꿀 수 있는 강조색 (4.5:1 대비 검증 후 저장)
  planStatus    PlanStatus @default(beta)
  betaStartedAt DateTime?
  betaEndsAt    DateTime?
  status        TenantStatus @default(active)

  // 학원 기본 정보
  regNo         String?  // 학원등록번호 (푸터 필수 표시)
  subjects      String?  // 교습과목
  targetGrades  String?
  address       String?
  phone         String?
  hours         String?
  kakaoChannelUrl  String?
  naverPlaceUrl       String?
  naverMapEmbedUrl    String?
  locationHeadline    String?
  transitInfo         String?
  parkingInfo         String?
  ga4MeasurementId    String?
  naverSiteVerification String? // 네이버 서치어드바이저 인증 코드
  naverPlaceMirror      Json?   // { phone, hours, address } — 플레이스 불일치 비교용

  // 관계
  sections      TenantSection[]
  memberships   Membership[]
  memberInvites MemberInvite[]
  notifyRecipients NotifyRecipient[]
  directorProfile  DirectorProfile?
  teachingPrinciples TeachingPrinciple[]
  facilities         Facility[]
  staffProfiles      StaffProfile[]
  classes       ClassItem[]
  levelTestSlots LevelTestSlot[]
  fees          Fee[]
  extraCosts    ExtraCost[]
  refundPolicyText RefundPolicyText?
  leads         Lead[]
  consents      Consent[]
  posts         Post[]
  reviews       Review[]
  resultStats   ResultStat[]
  messageTemplates MessageTemplate[]
  automationSettings AutomationSetting[]
  messages      Message[]
  monthlyReports MonthlyReport[]
  contactLogs   TenantContactLog[]
  proxyAccessLogs ProxyAccessLog[]
  feeChangeLogs FeeChangeLog[]
  shuttleStops  ShuttleStop[]
  faqItems      FaqItem[]

  @@map("tenants")
}

enum Theme {
  warm
  result
  bright
}

enum PlanStatus {
  beta
  paid
  ended
}

enum TenantStatus {
  active
  inactive
}

// ─────────────────────────────────────────────────────────
// 섹션 설정
// ─────────────────────────────────────────────────────────

model TenantSection {
  id         String  @id @default(cuid())
  tenantId   String
  sectionKey String  // hero | quick_info | director | principles | classes | ...
  enabled    Boolean @default(true)
  sortOrder  Int     @default(0)

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sectionKey])
  @@map("tenant_sections")
}

// ─────────────────────────────────────────────────────────
// 사용자 & 권한
// ─────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String   @unique
  name      String?
  image     String?

  memberships Membership[]

  @@map("users")
}

model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     MemberRole @default(staff)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("memberships")
}

enum MemberRole {
  platform_admin
  owner
  staff
}

model MemberInvite {
  id        String     @id @default(cuid())
  tenantId  String
  email     String
  role      MemberRole @default(staff)
  token     String     @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime   @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("member_invites")
}

// 새 상담 알림 받을 번호
model NotifyRecipient {
  id       String @id @default(cuid())
  tenantId String
  name     String
  phone    String

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notify_recipients")
}

// ─────────────────────────────────────────────────────────
// 학원 콘텐츠
// ─────────────────────────────────────────────────────────

model DirectorProfile {
  id           String  @id @default(cuid())
  tenantId     String  @unique
  photo        String?
  headline     String?
  philosophy   String?
  education    String?
  career       String?
  subjectsTaught String?

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("director_profiles")
}

model TeachingPrinciple {
  id          String  @id @default(cuid())
  tenantId    String
  number      String  // "01", "02", "03"
  title       String
  description String?
  sortOrder   Int     @default(0)

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("teaching_principles")
}

model Facility {
  id        String  @id @default(cuid())
  tenantId  String
  label     String
  photo     String?
  sortOrder Int     @default(0)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("facilities")
}

model StaffProfile {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  roleLabel String?
  photo     String?
  summary   String?
  sortOrder Int     @default(0)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model ClassItem {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  gradeBand    String?
  days         String[] // ["월", "수", "금"]
  startTime    String?
  endTime      String?
  capacity     Int?
  seatsLeft    Int?
  waitlistCount Int     @default(0)
  textbook     String?
  description  String?
  sortOrder    Int      @default(0)

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fees         Fee[]

  @@map("classes")
}

model LevelTestSlot {
  id       String  @id @default(cuid())
  tenantId String
  weekday  Int?    // 0=일 ~ 6=토
  time     String? // "10:00"
  date     DateTime? // 특정 날짜
  active   Boolean @default(true)
  capacity Int?    // 정원 (null=무제한)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@map("level_test_slots")
}

model Fee {
  id               String  @id @default(cuid())
  tenantId         String
  classId          String?
  label            String
  sessionsPerWeek  Int?
  monthlyHours     Int?
  amount           Int     // 원 단위
  note             String?

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class            ClassItem? @relation(fields: [classId], references: [id])

  @@map("fees")
}

model FeeChangeLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  tenantId  String
  actorEmail String
  snapshot  Json     // 변경 전 fees + extra_costs 배열 전체

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("fee_change_logs")
}

model ExtraCost {
  id       String @id @default(cuid())
  tenantId String
  label    String
  amount   Int
  note     String?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("extra_costs")
}

model RefundPolicyText {
  id       String @id @default(cuid())
  tenantId String @unique
  body     String // 학원법 시행령 기준 TODO(확인 필요)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("refund_policy_texts")
}

model ShuttleStop {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId  String
  stop      String  // 정류장명
  pickup    String? // 등원 시간
  dropoff   String? // 하원 시간
  sortOrder Int     @default(0)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("shuttle_stops")
}

// ─────────────────────────────────────────────────────────
// 상담 (lead) 파이프라인
// ─────────────────────────────────────────────────────────

model Lead {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId        String
  parentName      String
  phone           String   // 관리자 목록에서는 마스킹하여 표시
  studentGrade    String?
  school          String?
  consultType        ConsultType @default(level_test)
  preferredSlotId    String?
  testAt             DateTime?  // 확정된 레벨테스트 일시 (test_booked 전환 시 필수)
  message            String?
  source             String?    // utm_source or parsed referrer
  utm                Json?      // { source, medium, campaign, content, term }
  postId             String?    // 소식글에서 신청 시 연결
  status             LeadStatus @default(new)
  statusChangedAt    DateTime   @default(now())
  notEnrolledReason  String?    // 비용/시간/거리/타학원/기타
  retainUntil        DateTime?  // TODO(확인 필요): 개인정보 보존 기한, 기한 초과 시 익명화

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferredSlot   LevelTestSlot? @relation(fields: [preferredSlotId], references: [id])
  post            Post?          @relation(fields: [postId], references: [id])
  events          LeadEvent[]
  consents        Consent[]
  messages        Message[]

  @@map("leads")
}

enum ConsultType {
  level_test
  phone
  visit
  waitlist   // 수업 대기 신청 (class_id via message field)
}

enum LeadStatus {
  new
  contacted
  test_booked
  test_done    // 테스트 완료, 아직 결정 안 함
  no_show      // 노쇼
  enrolled
  not_enrolled
}

model LeadEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  leadId    String
  type      LeadEventType
  payload   Json?    // 상태변경 내용, 메모 등
  actorId   String?  // userId (null이면 시스템)

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_events")
}

enum LeadEventType {
  created
  status_changed
  note
  message_sent
  call
  receipt_skipped
}

model Consent {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())

  tenantId       String
  leadId         String
  type           ConsentType
  grantedAt      DateTime?
  revokedAt      DateTime?
  channel        String?  // "web" | "kakao"
  reconfirmDueAt DateTime? // 동의일 기준 2년 후 TODO(확인 필요)

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("consents")
}

enum ConsentType {
  privacy
  marketing
  night
}

// ─────────────────────────────────────────────────────────
// 콘텐츠 (소식, 후기, 성과)
// ─────────────────────────────────────────────────────────

model Post {
  id              String     @id @default(cuid())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenantId        String
  category        PostCategory @default(notice)
  title           String
  summaryFields   Json?      // { period, target, count, fee }
  body            String
  images          String[]
  status          PostStatus @default(draft)
  publishedAt     DateTime?
  sendKakao       Boolean    @default(false)
  kakaoScheduledAt DateTime?
  kakaoSentAt     DateTime?  // 카카오 발송 완료 시각 (null이면 미발송)

  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads           Lead[]

  @@map("posts")
}

// FAQ 섹션 (GEO/AI 검색 최적화 목적)
model FaqItem {
  id        String   @id @default(cuid())
  tenantId  String
  question  String
  answer    String
  sortOrder Int      @default(0)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("faq_items")
}

enum PostCategory {
  notice
  recruit
  exam
  gallery
}

enum PostStatus {
  draft
  scheduled
  published
}

model Review {
  id               String  @id @default(cuid())
  createdAt        DateTime @default(now())

  tenantId         String
  kind             ReviewKind @default(review)
  body             String?
  authorLabel      String?
  source           String?
  consentConfirmed Boolean @default(false) // false면 공개 불가
  consentFile      String? // 성적 사례는 파일 없으면 공개 불가
  beforeValue      String?
  afterValue       String?
  periodLabel      String?
  comment          String? // 원장 코멘트
  gradeBand        String? // "중등" | "고등" — 필터용
  showOnHome       Boolean @default(false)
  visible          Boolean @default(false) // consent 조건 충족 후 true 가능

  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

enum ReviewKind {
  review
  score_case
}

model ResultStat {
  id          String  @id @default(cuid())
  tenantId    String
  termLabel   String
  metrics     Json    // { label, value, unit }[]
  basisText   String  // NOT NULL — 없으면 공개 불가
  published   Boolean @default(false)

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("result_stats")
}

// ─────────────────────────────────────────────────────────
// 카카오 메시지
// ─────────────────────────────────────────────────────────

model MessageTemplate {
  id                  String  @id @default(cuid())
  tenantId            String
  scenario            MessageScenario
  kind                MessageKind @default(info)
  body                String
  providerTemplateCode String?
  reviewStatus        TemplateReviewStatus @default(draft)
  approvedBody        String? // 승인된 버전. 없으면 승인 전 발송 불가

  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scenario])
  @@map("message_templates")
}

enum MessageScenario {
  receipt
  reminder
  followup
  campaign
  owner_alert
  owner_reminder  // 미응대 상담 재알림 (new 상태 3시간 후)
  reconfirm
}

enum MessageKind {
  info
  ad
}

enum TemplateReviewStatus {
  draft
  pending
  approved
  rejected
}

model AutomationSetting {
  id         String  @id @default(cuid())
  tenantId   String
  scenario   MessageScenario
  enabled    Boolean @default(false)
  delayRule  Json?   // { days: 3, time: "18:00" } 등

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scenario])
  @@map("automation_settings")
}

model Message {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  tenantId      String
  leadId        String?
  scenario      MessageScenario
  kind          MessageKind
  channel       MessageChannel @default(alimtalk)
  recipientHash String   // HMAC-SHA256(phone) — 원문 저장 안 함
  status        MessageStatus @default(pending)
  scheduledAt   DateTime?    // 발송 예정 시각 (야간 지연 시 다음날 08:00)
  cost          Int?     // 원 단위
  sentAt        DateTime?
  error         String?

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead          Lead?    @relation(fields: [leadId], references: [id])

  @@map("messages")
}

enum MessageChannel {
  alimtalk
  brand
  sms_fallback
}

enum MessageStatus {
  pending
  sent
  failed
  deferred // 야간 차단으로 지연
}

// ─────────────────────────────────────────────────────────
// 리포트
// ─────────────────────────────────────────────────────────

model MonthlyReport {
  id           String  @id @default(cuid())
  tenantId     String
  month        String  // "2026-09"
  snapshot     Json    // 집계 데이터
  aiCheck      Json?   // AI 검색 점검 (운영자 수동 입력)
  managerNote  String?

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@map("monthly_reports")
}

// ─────────────────────────────────────────────────────────
// 첫등원 서비스 사이트 (F-05, F-06)
// ─────────────────────────────────────────────────────────

model DiagnosticRequest {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  academyName String
  area        String
  subject     String
  phone       String
  currentUrl  String?
  status      DiagnosticStatus @default(pending)
  resultNote  String?
  scores      Json?    // { item1: {score:1-3, note:""}, item2: ..., item3: ..., item4: ... }

  @@map("diagnostic_requests")
}

enum DiagnosticStatus {
  pending
  in_review
  done
}

model Application {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // 학원 정보
  academyName      String
  area             String
  subject          String
  directorName     String
  phone            String
  currentUrl       String?

  // 신청 상태
  status           ApplicationStatus @default(applied)
  queueOrder       Int?
  expectedStartDate DateTime?

  // 자료 업로드 (신청 후 2주 이내 제출 가능)
  uploadedFiles    String[]
  wantsPhotoShoot  Boolean  @default(false)

  // 동의 (4종: 약관, 개인정보, 베타 참여 조건, 익명 사례 공개)
  consentTerms     Boolean  @default(false)
  consentPrivacy   Boolean  @default(false)
  consentBeta      Boolean  @default(false)
  consentCase      Boolean  @default(false)

  @@map("applications")
}

model TenantContactLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  authorEmail String  // platform_admin email
  channel     String  // 'phone' | 'kakao' | 'email' | 'visit' | 'other'
  note        String  // 내용 메모

  @@index([tenantId])
  @@map("tenant_contact_logs")
}

model ProxyAccessLog {
  id          String   @id @default(cuid())
  accessedAt  DateTime @default(now())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  adminEmail  String   // platform_admin email

  @@index([tenantId])
  @@index([adminEmail])
  @@map("proxy_access_logs")
}

enum ApplicationStatus {
  applied       // 신청 접수
  waiting_docs  // 자료 대기
  in_progress   // 제작 중
  review        // 시안 확인
  ready         // 오픈 준비
}
