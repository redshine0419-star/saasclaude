generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// 플랫폼 설정 (미확정 대괄호 값들을 DB에서 관리)
// ─────────────────────────────────────────────────────────

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────
// 테넌트 (학원)
// ─────────────────────────────────────────────────────────

model Tenant {
  id                  String    @id @default(cuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  inactiveAt          DateTime? // 운영 중지(status=inactive) 시각 — 베타 만료·운영자 처리. 자동 삭제하지 않는다
  published           Boolean   @default(true) // 홈페이지 공개 여부 — 원장이 켜고 끈다. 꺼도 관리자 화면은 그대로 쓴다
  unpublishedAt       DateTime? // 홈페이지를 비공개로 바꾼 시각
  deletionRequestedAt DateTime? // 원장의 학원 삭제 요청 — 운영자가 확인 후 수동 삭제 (lib/retention.ts purgeTenant)
  deletionRequestedBy String?
  deletionReason      String?

  slug          String       @unique
  name          String
  theme         Theme        @default(warm)
  accentColor   String? // 원장이 바꿀 수 있는 강조색 (4.5:1 대비 검증 후 저장)
  planStatus    PlanStatus   @default(beta)
  betaStartedAt DateTime?
  betaEndsAt    DateTime?
  status        TenantStatus @default(active)

  // 학원 기본 정보
  regNo                 String? // 학원등록번호 (푸터 필수 표시)
  subjects              String? // 교습과목
  targetGrades          String?
  address               String?
  phone                 String?
  hours                 String?
  kakaoChannelUrl       String?
  naverPlaceUrl         String?
  naverMapEmbedUrl      String?
  locationHeadline      String?
  transitInfo           String?
  parkingInfo           String?
  // 메인 히어로 (원장이 관리자 "홈페이지 구성"에서 편집, 비우면 테마 기본 문구)
  heroBadge             String?
  heroTitle             String?
  heroSubtitle          String?
  heroPhotos            String[] @default([])
  sectionCopy           Json? // 섹션 제목·항목 문구 { [sectionKey]: { title?, items? } } — lib/section-copy.ts
  errorTypes            Json? // 과목별 오답 유형 { 수학: [...], 영어: [...] } — lib/level-test/error-types.ts, 없으면 기본 목록
  studentRegToken       String?  @unique // 학부모용 학생 등록 링크 토큰 — 재발급하면 예전 링크는 막힌다
  ga4MeasurementId      String?
  naverSiteVerification String? // 네이버 서치어드바이저 인증 코드
  naverPlaceMirror      Json? // { phone, hours, address } — 플레이스 불일치 비교용

  // 셀프 개설
  onboardedVia     String? // self_serve | operator
  signupConsents   Json? // { terms, privacy, beta, case, at, email } — 개설 시 동의 기록
  lifecycleNotices Json? // { d14, d3, d0, unpublish7: ISO 시각 } — 원장에게 보낸 베타 종료 안내

  // 커스텀 도메인 (원장 셀프 연결). verified일 때만 라우팅한다
  customDomain           String?   @unique
  customDomainStatus     String? // pending | verified
  customDomainVerifiedAt DateTime?

  // 관계
  sections             TenantSection[]
  memberships          Membership[]
  memberInvites        MemberInvite[]
  notifyRecipients     NotifyRecipient[]
  directorProfile      DirectorProfile?
  teachingPrinciples   TeachingPrinciple[]
  facilities           Facility[]
  staffProfiles        StaffProfile[]
  classes              ClassItem[]
  levelTestSlots       LevelTestSlot[]
  fees                 Fee[]
  extraCosts           ExtraCost[]
  refundPolicyText     RefundPolicyText?
  leads                Lead[]
  consents             Consent[]
  posts                Post[]
  reviews              Review[]
  resultStats          ResultStat[]
  messageTemplates     MessageTemplate[]
  automationSettings   AutomationSetting[]
  messages             Message[]
  monthlyReports       MonthlyReport[]
  contactLogs          TenantContactLog[]
  proxyAccessLogs      ProxyAccessLog[]
  feeChangeLogs        FeeChangeLog[]
  shuttleStops         ShuttleStop[]
  faqItems             FaqItem[]
  siteVersions         SiteVersion[]
  aiDraftLogs          AiDraftLog[]
  questions            Question[]
  tests                Test[]
  testAttempts         TestAttempt[]
  testResponses        TestResponse[]
  students             Student[]
  studentRegistrations StudentRegistration[]
  studentNotes         StudentNote[]
  studentScores        StudentScore[]
  attendances          Attendance[]
  studentReports       StudentReport[]
  subscription         Subscription?
  payments             Payment[]

  @@map("tenants")
}

enum Theme {
  warm
  result
  bright
}

enum PlanStatus {
  beta
  paid
  ended
}

enum TenantStatus {
  active
  inactive
}

// ─────────────────────────────────────────────────────────
// 섹션 설정
// ─────────────────────────────────────────────────────────

// AI 초안 사용 기록 (학원별 일일 한도·비용 추적). 원문은 저장하지 않는다.
model AiDraftLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  tenantId     String
  kind         String // director
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("ai_draft_logs")
}

// 홈페이지 구성(테마·강조색·섹션) 변경 이력. 원장이 이전 상태로 되돌릴 수 있다.
model SiteVersion {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  tenantId   String
  actorEmail String
  reason     String // sections | accent | restore | onboarding
  snapshot   Json // { theme, accentColor, sections: [{ key, enabled, sortOrder }] }

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("site_versions")
}

model TenantSection {
  id         String  @id @default(cuid())
  tenantId   String
  sectionKey String // hero | quick_info | director | principles | classes | ...
  enabled    Boolean @default(true)
  sortOrder  Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sectionKey])
  @@map("tenant_sections")
}

// ─────────────────────────────────────────────────────────
// 사용자 & 권한
// ─────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String   @unique
  name      String?
  image     String?

  // 회원가입 동의 (lib/legal) — 필수 동의가 없거나 문서 버전이 바뀌면 다시 받는다
  ageConfirmedAt     DateTime? // 만 14세 이상 확인
  termsAgreedAt      DateTime?
  privacyAgreedAt    DateTime?
  consentVersion     String? // 동의한 약관·처리방침 버전
  marketingAgreedAt  DateTime? // 선택: 마케팅 정보 수신 (이메일·문자)
  marketingRevokedAt DateTime? // 광고성 정보 수신 동의 (marketingAgreedAt과 짝)
  promoAgreedAt      DateTime? // 홍보 목적 개인정보 수집·이용 동의 (선택)
  promoRevokedAt     DateTime?

  memberships Membership[]
  consentLogs UserConsentLog[]

  @@map("users")
}

// 회원 동의·철회 이력 (증빙용, 지우지 않는다 — 탈퇴 시 회원과 함께 삭제)
model UserConsentLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  type      String // age | terms | privacy | marketing
  action    String // agree | revoke
  version   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_consent_logs")
}

model Membership {
  id       String     @id @default(cuid())
  tenantId String
  userId   String
  role     MemberRole @default(staff)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("memberships")
}

enum MemberRole {
  platform_admin
  owner
  staff
}

model MemberInvite {
  id        String     @id @default(cuid())
  tenantId  String
  email     String
  role      MemberRole @default(staff)
  token     String     @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("member_invites")
}

// 새 상담 알림 받을 번호
model NotifyRecipient {
  id       String @id @default(cuid())
  tenantId String
  name     String
  phone    String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notify_recipients")
}

// ─────────────────────────────────────────────────────────
// 학원 콘텐츠
// ─────────────────────────────────────────────────────────

model DirectorProfile {
  id             String  @id @default(cuid())
  tenantId       String  @unique
  photo          String?
  headline       String?
  philosophy     String?
  education      String?
  career         String?
  subjectsTaught String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("director_profiles")
}

model TeachingPrinciple {
  id          String  @id @default(cuid())
  tenantId    String
  number      String // "01", "02", "03"
  title       String
  description String?
  sortOrder   Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("teaching_principles")
}

model Facility {
  id        String  @id @default(cuid())
  tenantId  String
  label     String
  photo     String?
  sortOrder Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("facilities")
}

model StaffProfile {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  roleLabel String?
  photo     String?
  summary   String?
  sortOrder Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model ClassItem {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  gradeBand     String?
  days          String[] // ["월", "수", "금"]
  startTime     String?
  endTime       String?
  capacity      Int?
  seatsLeft     Int?
  waitlistCount Int      @default(0)
  textbook      String?
  description   String?
  photo         String? // 홈페이지 반 카드 사진 (없으면 사진 없는 카드)
  sortOrder     Int      @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fees     Fee[]
  students Student[]

  @@map("classes")
}

model LevelTestSlot {
  id       String    @id @default(cuid())
  tenantId String
  weekday  Int? // 0=일 ~ 6=토
  time     String? // "10:00"
  date     DateTime? // 특정 날짜
  active   Boolean   @default(true)
  capacity Int? // 정원 (null=무제한)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@map("level_test_slots")
}

model Fee {
  id              String  @id @default(cuid())
  tenantId        String
  classId         String?
  label           String
  sessionsPerWeek Int?
  monthlyHours    Int?
  amount          Int // 원 단위
  note            String?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class  ClassItem? @relation(fields: [classId], references: [id])

  @@map("fees")
}

model FeeChangeLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  tenantId   String
  actorEmail String
  snapshot   Json // 변경 전 fees + extra_costs 배열 전체

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("fee_change_logs")
}

model ExtraCost {
  id       String  @id @default(cuid())
  tenantId String
  label    String
  amount   Int
  note     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("extra_costs")
}

model RefundPolicyText {
  id       String @id @default(cuid())
  tenantId String @unique
  body     String // 학원법 시행령 기준 TODO(확인 필요)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("refund_policy_texts")
}

model ShuttleStop {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId  String
  stop      String // 정류장명
  pickup    String? // 등원 시간
  dropoff   String? // 하원 시간
  sortOrder Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("shuttle_stops")
}

// ─────────────────────────────────────────────────────────
// 상담 (lead) 파이프라인
// ─────────────────────────────────────────────────────────

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId          String
  parentName        String
  phone             String // 관리자 목록에서는 마스킹하여 표시
  studentGrade      String?
  school            String?
  consultType       ConsultType @default(level_test)
  preferredSlotId   String?
  testAt            DateTime? // 확정된 레벨테스트 일시 (test_booked 전환 시 필수)
  message           String?
  source            String? // utm_source or parsed referrer
  utm               Json? // { source, medium, campaign, content, term }
  postId            String? // 소식글에서 신청 시 연결
  status            LeadStatus  @default(new)
  statusChangedAt   DateTime    @default(now())
  notEnrolledReason String? // 비용/시간/거리/타학원/기타
  retainUntil       DateTime? // TODO(확인 필요): 개인정보 보존 기한, 기한 초과 시 익명화

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferredSlot LevelTestSlot? @relation(fields: [preferredSlotId], references: [id])
  post          Post?          @relation(fields: [postId], references: [id])
  events        LeadEvent[]
  consents      Consent[]
  messages      Message[]
  testAttempts  TestAttempt[]
  student       Student?

  @@map("leads")
}

enum ConsultType {
  level_test
  phone
  visit
  waitlist // 수업 대기 신청 (class_id via message field)
}

enum LeadStatus {
  new
  contacted
  test_booked
  test_done // 테스트 완료, 아직 결정 안 함
  no_show // 노쇼
  enrolled
  not_enrolled
}

model LeadEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  leadId  String
  type    LeadEventType
  payload Json? // 상태변경 내용, 메모 등
  actorId String? // userId (null이면 시스템)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_events")
}

enum LeadEventType {
  created
  status_changed
  note
  message_sent
  call
  receipt_skipped
}

model Consent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tenantId       String
  leadId         String
  type           ConsentType
  grantedAt      DateTime?
  revokedAt      DateTime?
  channel        String? // "web" | "kakao"
  reconfirmDueAt DateTime? // 동의일 기준 2년 후 TODO(확인 필요)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("consents")
}

enum ConsentType {
  privacy
  marketing
  night
}

// ─────────────────────────────────────────────────────────
// 콘텐츠 (소식, 후기, 성과)
// ─────────────────────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId         String
  category         PostCategory @default(notice)
  title            String
  summaryFields    Json? // { period, target, count, fee }
  body             String
  images           String[]
  status           PostStatus   @default(draft)
  publishedAt      DateTime?
  sendKakao        Boolean      @default(false)
  kakaoScheduledAt DateTime?
  kakaoSentAt      DateTime? // 카카오 발송 완료 시각 (null이면 미발송)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@map("posts")
}

// FAQ 섹션 (GEO/AI 검색 최적화 목적)
model FaqItem {
  id        String @id @default(cuid())
  tenantId  String
  question  String
  answer    String
  sortOrder Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("faq_items")
}

enum PostCategory {
  notice
  recruit
  exam
  gallery
}

enum PostStatus {
  draft
  scheduled
  published
}

model Review {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tenantId         String
  kind             ReviewKind @default(review)
  body             String?
  authorLabel      String?
  source           String?
  consentConfirmed Boolean    @default(false) // false면 공개 불가
  consentFile      String? // 성적 사례는 파일 없으면 공개 불가
  beforeValue      String?
  afterValue       String?
  periodLabel      String?
  comment          String? // 원장 코멘트
  gradeBand        String? // "중등" | "고등" — 필터용
  showOnHome       Boolean    @default(false)
  visible          Boolean    @default(false) // consent 조건 충족 후 true 가능

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

enum ReviewKind {
  review
  score_case
}

model ResultStat {
  id        String  @id @default(cuid())
  tenantId  String
  termLabel String
  metrics   Json // { label, value, unit }[]
  basisText String // NOT NULL — 없으면 공개 불가
  published Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("result_stats")
}

// ─────────────────────────────────────────────────────────
// 카카오 메시지
// ─────────────────────────────────────────────────────────

model MessageTemplate {
  id                   String               @id @default(cuid())
  tenantId             String
  scenario             MessageScenario
  kind                 MessageKind          @default(info)
  body                 String
  providerTemplateCode String?
  reviewStatus         TemplateReviewStatus @default(draft)
  approvedBody         String? // 승인된 버전. 없으면 승인 전 발송 불가

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scenario])
  @@map("message_templates")
}

enum MessageScenario {
  receipt
  reminder
  followup
  campaign
  owner_alert
  owner_reminder // 미응대 상담 재알림 (new 상태 3시간 후)
  reconfirm
}

enum MessageKind {
  info
  ad
}

enum TemplateReviewStatus {
  draft
  pending
  approved
  rejected
}

model AutomationSetting {
  id        String          @id @default(cuid())
  tenantId  String
  scenario  MessageScenario
  enabled   Boolean         @default(false)
  delayRule Json? // { days: 3, time: "18:00" } 등

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scenario])
  @@map("automation_settings")
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tenantId      String
  leadId        String?
  scenario      MessageScenario
  kind          MessageKind
  channel       MessageChannel  @default(alimtalk)
  recipientHash String // HMAC-SHA256(phone) — 원문 저장 안 함
  status        MessageStatus   @default(pending)
  scheduledAt   DateTime? // 발송 예정 시각 (야간 지연 시 다음날 08:00)
  cost          Int? // 원 단위
  sentAt        DateTime?
  error         String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead?  @relation(fields: [leadId], references: [id])

  @@map("messages")
}

enum MessageChannel {
  alimtalk
  brand
  sms_fallback
}

enum MessageStatus {
  pending
  sent
  failed
  deferred // 야간 차단으로 지연
}

// ─────────────────────────────────────────────────────────
// 리포트
// ─────────────────────────────────────────────────────────

model MonthlyReport {
  id          String  @id @default(cuid())
  tenantId    String
  month       String // "2026-09"
  snapshot    Json // 집계 데이터
  aiCheck     Json? // AI 검색 점검 (운영자 수동 입력)
  managerNote String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@map("monthly_reports")
}

// ─────────────────────────────────────────────────────────
// 첫등원 서비스 사이트 (F-05, F-06)
// ─────────────────────────────────────────────────────────

model DiagnosticRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  academyName     String
  area            String
  subject         String
  phone           String
  currentUrl      String?
  status          DiagnosticStatus @default(pending)
  resultNote      String?
  scores          Json? // { item1: {score:1-3, note:""}, item2: ..., item3: ..., item4: ... }
  privacyAgreedAt DateTime? // 개인정보 수집·이용 동의 (필수)
  adAgreedAt      DateTime? // 광고성 정보 수신 동의 (선택)

  @@map("diagnostic_requests")
}

enum DiagnosticStatus {
  pending
  in_review
  done
}

/// 제작 대행 신청(F-06) — 기능은 2026-11 삭제. 기존 신청 데이터 보관용으로만 남긴다(화면·API 없음).
model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 학원 정보
  academyName  String
  area         String
  subject      String
  directorName String
  phone        String
  currentUrl   String?

  // 신청 상태
  status            ApplicationStatus @default(applied)
  queueOrder        Int?
  expectedStartDate DateTime?

  // 자료 업로드 (신청 후 2주 이내 제출 가능)
  uploadedFiles   String[]
  wantsPhotoShoot Boolean  @default(false)

  // 동의 (4종: 약관, 개인정보, 베타 참여 조건, 익명 사례 공개)
  consentTerms   Boolean @default(false)
  consentPrivacy Boolean @default(false)
  consentBeta    Boolean @default(false)
  consentCase    Boolean @default(false)

  @@map("applications")
}

model TenantContactLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  authorEmail String // platform_admin email
  channel     String // 'phone' | 'kakao' | 'email' | 'visit' | 'other'
  note        String // 내용 메모

  @@index([tenantId])
  @@map("tenant_contact_logs")
}

model ProxyAccessLog {
  id         String   @id @default(cuid())
  accessedAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  adminEmail String // platform_admin email

  @@index([tenantId])
  @@index([adminEmail])
  @@map("proxy_access_logs")
}

enum ApplicationStatus {
  applied // 신청 접수
  waiting_docs // 자료 대기
  in_progress // 제작 중
  review // 시안 확인
  ready // 오픈 준비
}

// ─────────────────────────────────────────────────────────
// 온라인 레벨테스트 (문제은행·시험지·응시·채점) — SPEC 13장
// ─────────────────────────────────────────────────────────

enum QuestionType {
  choice // 객관식 (보기 중 하나)
  short // 단답형 (허용 답안 목록과 비교)
  essay // 서술형 (글·풀이 사진, 선생님이 채점)
}

model Question {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenantId    String
  type        QuestionType
  subject     String // 수학, 영어 ...
  grade       String? // 중1, 고1 ...
  unit        String? // 단원
  difficulty  Int          @default(3) // 1(쉬움) ~ 5(어려움)
  body        String // 본문. $...$ / $$...$$ 는 수식(KaTeX)
  imageUrl    String?
  choices     Json? // 객관식: ["보기1", "보기2", ...]
  answers     String[] // 객관식: ["3"](1부터), 단답형: 허용 답안 목록, 서술형: 빈 배열
  explanation String? // 해설(서술형은 모범답안·채점 기준) — 학생·학부모에게는 보여주지 않는다
  points      Int          @default(1)
  archived    Boolean      @default(false)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  testItems TestItem[]
  responses TestResponse[]

  @@index([tenantId, archived])
  @@map("questions")
}

model Test {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenantId     String
  title        String
  grade        String?
  description  String? // 응시 전 안내 문구
  timeLimitMin Int? // 제한 시간(분). 없으면 무제한
  archived     Boolean  @default(false)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    TestItem[]
  attempts TestAttempt[]

  @@index([tenantId, archived])
  @@map("tests")
}

model TestItem {
  id         String @id @default(cuid())
  testId     String
  questionId String
  sortOrder  Int    @default(0)
  points     Int    @default(1)

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([testId, questionId])
  @@map("test_items")
}

enum AttemptStatus {
  issued // 링크 발급, 아직 시작 전
  in_progress
  submitted
}

model TestAttempt {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  tenantId     String
  testId       String
  leadId       String? // 상담 건에 연결 — 응시 화면에서 학생 개인정보를 따로 받지 않는다
  token        String        @unique // 응시·결과 링크용 추측 불가 토큰
  status       AttemptStatus @default(issued)
  startedAt    DateTime?
  submittedAt  DateTime?
  score        Int?
  maxScore     Int?
  needsGrading Boolean       @default(false) // 서술형 채점 대기 — 채점 완료 전 score는 자동 채점분만
  gradedAt     DateTime?
  issuedBy     String? // 발급한 관리자 이메일

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  test      Test           @relation(fields: [testId], references: [id], onDelete: Restrict)
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  responses TestResponse[]

  @@index([tenantId, testId])
  @@index([leadId])
  @@index([tenantId, needsGrading])
  @@map("test_attempts")
}

model TestResponse {
  id         String   @id @default(cuid())
  updatedAt  DateTime @updatedAt
  tenantId   String
  attemptId  String
  questionId String
  answer     String // 객관식은 보기 번호(1부터), 단답형·서술형은 입력값
  photos     String[] @default([]) // 서술형 풀이 사진 (최대 3장)
  correct    Boolean? // 제출 후 채점. 서술형은 만점일 때 true
  points     Int? // 서술형은 선생님이 채점하기 전까지 null
  feedback   String? // 첨삭 코멘트 — 채점 완료 후 결과지에 보인다
  errorType  String? // concept | calculation | condition | reading | other
  marks      String[] @default([]) // 사진별 펜 표시(0~1 좌표 선 묶음 JSON, lib/level-test/marks.ts), photos와 같은 순서
  gradedBy   String?

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@map("test_responses")
}

// ─── 학생부 (SPEC 14장) ─────────────────────────────────────────────────────
// 관리자 전용. 학부모 화면·공개 페이지에 어떤 경로로도 노출하지 않는다.

enum StudentStatus {
  active // 재원
  paused // 휴원
  left // (사용 안 함) 퇴원 시 학생부를 즉시 파기한다 — SPEC 14장
}

model Student {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenantId      String
  name          String
  grade         String? // 예: 중2
  school        String?
  classId       String?
  status        StudentStatus @default(active)
  enrolledAt    DateTime      @default(now())
  leftAt        DateTime?
  parentName    String?
  parentPhone   String? // 목록에서는 마스킹, 상세에서만 전체 표시
  studentPhone  String?
  traits        String[]      @default([]) // 성격·특성 태그
  summary       String? // 한 줄 요약 (선생님 메모)
  consentAt     DateTime?     @db.Date // 학부모(법정대리인) 개인정보 수집·이용 동의 받은 날
  consentMethod String? // written | electronic | other — lib/students/labels.ts
  leadId        String?       @unique // 입학 전 상담 건 — 상담 이력·레벨테스트 연결
  createdBy     String?

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class       ClassItem?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  notes       StudentNote[]
  scores      StudentScore[]
  attendances Attendance[]
  reports     StudentReport[]

  @@index([tenantId, status])
  @@index([tenantId, classId])
  @@map("students")
}

/// 학부모가 등록 링크로 제출한 학생 정보 — 원장이 승인하면 Student로 옮기고 이 행은 지운다.
/// 승인하지 않은 건은 30일 뒤 자동 삭제 (lib/students/registration.ts)
model StudentRegistration {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  tenantId       String
  studentName    String
  grade          String?
  school         String?
  studentPhone   String?
  parentName     String
  parentPhone    String
  memo           String?
  consentAt      DateTime // 학부모(법정대리인) 전자 동의 시각
  consentVersion String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("student_registrations")
}

enum StudentNoteKind {
  attitude // 학습 태도
  personality // 성격·특성
  consult // 상담
  parent // 학부모 소통
  other
}

model StudentNote {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  tenantId    String
  studentId   String
  kind        StudentNoteKind @default(other)
  body        String
  authorEmail String
  authorName  String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, createdAt])
  @@map("student_notes")
}

enum ScoreKind {
  school // 학교 내신
  mock // 모의고사
  academy // 학원 자체 테스트
}

model StudentScore {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  tenantId   String
  studentId  String
  kind       ScoreKind
  examDate   DateTime  @db.Date
  label      String // 예: 2학기 중간고사, 6월 모의평가
  subject    String
  score      Float
  maxScore   Float     @default(100)
  rankGrade  Int? // 등급 (1~9)
  percentile Float? // 백분위
  memo       String?
  createdBy  String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, examDate])
  @@map("student_scores")
}

enum AttendanceStatus {
  present // 출석
  late // 지각
  absent // 결석
  excused // 사유 결석
}

model Attendance {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenantId  String
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?
  checkedBy String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId, date])
  @@map("attendances")
}

// 학부모 공유 리포트 — 발행 시점 스냅샷. 학생부의 다른 기록(관찰 메모·성격 태그)은 넣지 않는다 (SPEC 14장)
model StudentReport {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  tenantId     String
  studentId    String
  token        String    @unique // 공유 링크용 추측 불가 토큰
  periodStart  DateTime  @db.Date
  periodEnd    DateTime  @db.Date
  comment      String // 선생님이 학부모에게 쓰는 코멘트
  snapshot     Json // lib/students/report.ts ReportSnapshot
  expiresAt    DateTime
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdBy    String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, createdAt])
  @@map("student_reports")
}

// ─── 카드 정기결제 (SPEC 10장) ─────────────────────────────────────────────
// 지금은 모의 결제(lib/billing/mock.ts). 카드 번호는 어떤 경우에도 저장하지 않는다 — PG가 준 빌링키·표시용 카드 이름만

enum SubscriptionStatus {
  active // 정상 — 결제일에 자동 청구
  past_due // 결제 실패 — 재시도 중
  canceled // 해지 — 더 청구하지 않음
}

model Subscription {
  id                  String             @id @default(cuid())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenantId            String             @unique
  status              SubscriptionStatus @default(active)
  provider            String // mock | (PG 연동 후) toss 등
  billingKey          String // PG 빌링키 (모의: mock_...)
  cardLabel           String // 화면 표시용 (예: 모의카드 ****4242)
  nextBillingAt       DateTime
  failCount           Int                @default(0)
  consentAt           DateTime // 정기결제 동의 시각
  consentBy           String // 동의한 원장 이메일
  thirdPartyConsentAt DateTime? // 결제대행사 개인정보 제3자 제공 동의
  canceledAt          DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([status, nextBillingAt])
  @@map("subscriptions")
}

enum PaymentStatus {
  paid
  failed
}

/// 파기된 학원의 결제 기록 — 전자상거래법(대금 결제·공급 기록 5년) 보관용. 학원 테이블과 연결하지 않는다.
model PaymentArchive {
  id          String   @id @default(cuid())
  archivedAt  DateTime @default(now())
  deleteAfter DateTime // 결제일 + 5년
  tenantName  String
  tenantSlug  String
  regNo       String?
  orderId     String   @unique
  tierKey     String
  amount      Int
  status      String
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime

  @@index([deleteAfter])
  @@map("payment_archives")
}

model Payment {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  tenantId       String
  subscriptionId String
  orderId        String        @unique
  tierKey        String // free | standard | plus
  activeStudents Int // 청구 시점 재원생 수
  amount         Int // 원
  status         PaymentStatus
  failReason     String?
  periodStart    DateTime
  periodEnd      DateTime

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("payments")
}
